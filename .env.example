# Required only when --agent-backend openai (or auto with live agents) is used.
OPENAI_API_KEY=replace_with_your_key

# Frozen cost snapshot for the default gpt-5.6-luna experiments.
OPENAI_INPUT_USD_PER_MILLION=0.20
OPENAI_CACHED_INPUT_USD_PER_MILLION=0.02
OPENAI_CACHE_WRITE_USD_PER_MILLION=0.25
OPENAI_OUTPUT_USD_PER_MILLION=1.20

# Optional day-ahead MILP controls.
DA_SOLVER_ORDER=gurobi,appsi_highs,highs,cbc,glpk
DA_SOLVER_TIME_LIMIT=60
DA_SOLVER_MIP_GAP=0.04
DA_SOLVER_TEE=false
# Gap used by the two-stage dumb-charging baseline. The benchmark objective
# does not price energy, so its optimal face contains schedules with very
# different costs; the cost tie-break only yields a unique baseline at gap 0.
DA_DUMB_CHARGING_MIP_GAP=0.0

# Optional real-time MILP controls.
RT_SOLVER_ORDER=gurobi,appsi_highs,highs,cbc,glpk
RT_SOLVER_TIME_LIMIT=60
RT_SOLVER_MIP_GAP=0.02
RT_SOLVER_TEE=false

# Leave unset when Gurobi already discovers the installed license. Set this
# only when deliberately selecting a specific license file; it overrides the
# working default-license search.
# GRB_LICENSE_FILE=C:\path\to\gurobi.lic
